{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Top-level container for creative projects",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "subtype": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived", "completed"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "aiInstructions": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "fontStyle": { "type": "string" },
        "visualMood": { "type": "array", "items": { "type": "string" } },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "outputFormats": { "type": "array", "items": { "type": "string" } },
        "collaborators": { "type": "array", "items": { "type": "string" }, "description": "Emails of users who can view this project" }
      },
      "required": ["name", "type", "userId", "createdAt", "updatedAt"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Generated or uploaded asset within a project",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video", "audio", "document", "reference"] },
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isFavorited": { "type": "boolean" }
      },
      "required": ["name", "type", "url", "userId", "createdAt"]
    },
    "Chat": {
      "title": "Chat Session",
      "description": "A conversation session with Gemini",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the chat" },
        "projectId": { "type": "string", "description": "The ID of the parent project" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the chat was created" },
        "userId": { "type": "string", "description": "The ID of the user who owns this chat" },
        "lastMessage": { "type": "string", "description": "The last message in the chat" }
      },
      "required": ["title", "createdAt", "userId", "projectId"]
    },
    "Workflow": {
      "title": "Workflow",
      "description": "A node-based creative workflow",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "projectId": { "type": "string" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "userId", "projectId", "createdAt"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "An individual message within a chat",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "The ID of the parent chat" },
        "role": { "type": "string", "enum": ["user", "model"], "description": "The sender's role" },
        "text": { "type": "string", "description": "The message content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the message was sent" }
      },
      "required": ["chatId", "role", "text", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/projects/{projectId}/assets/{assetId}": {
      "schema": "Asset",
      "description": "Project assets within a project"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Collection of chat sessions"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a specific chat session"
    },
    "/workflows/{workflowId}": {
      "schema": "Workflow",
      "description": "User workflows"
    }
  }
}
