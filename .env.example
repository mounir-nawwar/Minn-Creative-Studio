# .env.example — copy to .env and fill in your values (never commit .env)

# Server
PORT=3000
NODE_ENV=production

# App users (login credentials — the app has exactly two users)
USER_MOUNIR_PASSWORD=change-me
USER_RANA_PASSWORD=change-me

# JWT secrets (32+ chars each, must be distinct)
JWT_SECRET=a-very-secret-string-at-least-32-chars
JWT_REFRESH_SECRET=a-different-secret-string-at-least-32-chars

# Session secret (legacy cookie auth, 32+ chars)
SESSION_SECRET=another-secret-string-at-least-32-chars

# Admin (legacy routes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Google Cloud — Vertex AI only (no Firebase)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
# Path to a service-account JSON key, OR leave unset to use gcloud ADC
# (gcloud auth application-default login). Required for Vertex AI generation.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Local storage (filesystem — replaces Firebase Storage)
STORAGE_PATH=/home/ubuntu/storage
PUBLIC_URL_BASE=/storage
