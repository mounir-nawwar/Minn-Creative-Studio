rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: {projectId}
    // Fields:
    //   - name: string (required)
    //   - type: string (required)
    //   - userId: string (required)
    //   - createdAt: timestamp (required)
    //   - updatedAt: timestamp (required)
    //
    // Collection: projects/{projectId}/assets
    // Document ID: {assetId}
    // Fields:
    //   - name: string (required)
    //   - type: string (required)
    //   - url: string (required)
    //   - userId: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: chats
    // Document ID: {chatId}
    // Fields:
    //   - title: string (required)
    //   - projectId: string (required)
    //   - createdAt: timestamp (required)
    //   - userId: string (required)
    //
    // Collection: workflows
    // Document ID: {workflowId}
    // Fields:
    //   - name: string (required)
    //   - projectId: string (required)
    //   - userId: string (required)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'type', 'userId', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.userId == request.auth.uid;
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['name', 'type', 'url', 'userId', 'createdAt']) &&
             data.userId == request.auth.uid;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['title', 'projectId', 'createdAt', 'userId']) &&
             data.title is string && data.title.size() > 0 &&
             data.userId == request.auth.uid;
    }

    function isValidWorkflow(data) {
      return data.keys().hasAll(['name', 'projectId', 'userId', 'createdAt']) &&
             data.userId == request.auth.uid;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['chatId', 'role', 'text', 'createdAt']) &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() > 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /projects/{projectId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isValidProject(request.resource.data);

      match /assets/{assetId} {
        allow read, update, delete: if isOwner(resource.data.userId);
        allow create: if isAuthenticated() && isValidAsset(request.resource.data);
      }
    }

    match /chats/{chatId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isValidChat(request.resource.data);

      match /messages/{messageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/chats/$(chatId)).data.userId);
        allow create: if isAuthenticated() && 
                       isOwner(get(/databases/$(database)/documents/chats/$(chatId)).data.userId) &&
                       isValidMessage(request.resource.data);
      }
    }

    match /workflows/{workflowId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isValidWorkflow(request.resource.data);
    }
  }
}
